<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build with Source/build.sh (it points the framework at RimWorld's own Managed folder). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Nephila</AssemblyName>
    <RootNamespace>Nephila</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <DebugType>none</DebugType>
    <OutputPath>../../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <RimWorld>..\..\..\..</RimWorld>
    <Managed>$(RimWorld)\RimWorldWin64_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="mscorlib"><HintPath>$(Managed)\mscorlib.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System"><HintPath>$(Managed)\System.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(Managed)\System.Core.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Xml"><HintPath>$(Managed)\System.Xml.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(Managed)\netstandard.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RimWorld)\Mods\RimRound\Source\Dev\harmony16\Current\Assemblies\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="AlienRace"><HintPath>$(RimWorld)\Mods\RimRound\Source\Dev\har\1.6\Assemblies\AlienRace.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="RimRound"><HintPath>$(RimWorld)\Mods\RimRound\1.6\Assemblies\RimRound.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
