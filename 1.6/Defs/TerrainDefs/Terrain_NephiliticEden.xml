	<TerrainDef ParentName="NephilaBurnedFloorBase">
		<defName>NephilaBurnedTile</defName>
		<label>burned nephilim flooring</label>
		<renderPrecedence>251</renderPrecedence>
		<description>An artificially constructed floor of nephilim design that has been burned near to ashes. Whatever bizarre creatures might once have lived here are long since dead.</description>
		<texturePath>Terrain/Surfaces/Concrete</texturePath>
		<edgeType>FadeRough</edgeType>
		<pathCost>150</pathCost>
	</TerrainDef>




  
