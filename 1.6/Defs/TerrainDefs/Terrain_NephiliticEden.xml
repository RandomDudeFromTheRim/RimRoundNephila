<?xml version="1.0" encoding="utf-8" ?>
<Defs>

   <TerrainDef ParentName="NaturalTerrainBase">
    <defName>Neph_NephilaSoil</defName>
    <label>soil</label>
    <texturePath>Terrain/Neph_NephilaSoil</texturePath>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>340</renderPrecedence>
    <pathCost>2</pathCost>
    <statBases>
      <Beauty>-1</Beauty>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <scatterType>Rocky</scatterType>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <fertility>1.0</fertility>
    <takeFootprints>True</takeFootprints>
    <tools>
      <li>
        <label>dirt</label>
        <capacities>
          <li>KickMaterialInEyes</li>
        </capacities>
        <hediff>DirtInEyes</hediff>
        <cooldownTime>1.5</cooldownTime>
      </li>
    </tools>
  </TerrainDef>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>Neph_NephilaMossyTerrain</defName>
    <label>lichen-covered soil</label>
    <texturePath>Terrain/Neph_NephilaMossy</texturePath>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>315</renderPrecedence>
    <pathCost>3</pathCost>
    <statBases>
      <Beauty>-1</Beauty>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <fertility>1</fertility>
    <takeFootprints>True</takeFootprints>
    <avoidWander>false</avoidWander>
  </TerrainDef>
  
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>Neph_NephilaSoilRich</defName>
    <label>rich soil</label>
    <texturePath>Terrain/Neph_NephilaSoilRich</texturePath>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>335</renderPrecedence>
    <pathCost>2</pathCost>
    <statBases>
      <Beauty>-1</Beauty>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <fertility>1.4</fertility>
    <takeFootprints>True</takeFootprints>
    <tools>
      <li>
        <label>dirt</label>
        <capacities>
          <li>KickMaterialInEyes</li>
        </capacities>
        <hediff>DirtInEyes</hediff>
        <cooldownTime>1.5</cooldownTime>
      </li>
    </tools>
  </TerrainDef>  
  

