<Defs>
<PawnKindDef Name="NephilaQueensGuard" Abstract="True">
    <defName>NephilaQueensGuard</defName>
    <label>nephila queen's guard</label>
    <race>NephilaQueensGuard</race>	
    <royalTitleChance>1</royalTitleChance>
