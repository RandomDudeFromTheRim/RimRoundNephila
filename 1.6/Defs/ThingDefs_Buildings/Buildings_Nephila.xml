  <ThingDef ParentName="BuildingBase" Name="Turret_NephilaLustCannon">
    <defName>Turret_NephilaLustCannon</defName>
    <label>nephila guardian cherub</label>
    <description>A specially mutated Nephila cherub that has sacrificed mobility for the ability to project a lust inducing nanite projectile. The lust distracts those effected by it, and can even drive them berserk! Solid, power-free early game turret, but has low range and must be fed meat regularly to avoid starvation.</description>
    <thingClass>Building_TurretGun</thingClass>
    <graphicData>
      <texPath>Things/Buildings/Security/Turret/NephilaGooTurretBase</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.5, 2.5)</drawSize>
      <damageData>
        <rect>(0.0,0.0,0.0,0.0)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Buildings/Security/Turret/NephilaGooTurret_Top</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>true</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <Flammability>0.8</Flammability>
      <WorkToBuild>5000</WorkToBuild>
      <Mass>100</Mass>
      <Beauty>2</Beauty>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>progress toward starvation</fuelLabel>
        <fuelConsumptionRate>1.5</fuelConsumptionRate>		
        <fuelGizmoLabel>Hunger</fuelGizmoLabel>
        <fuelFilter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </fuelFilter>
		<destroyOnNoFuel>true</destroyOnNoFuel>
        <fuelCapacity>15</fuelCapacity>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.75</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <fuelMultiplier>0.15</fuelMultiplier>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>false</consumeFuelOnlyWhenUsed>
        <outOfFuelMessage>One of your emplaced cherubim has starved to death!</outOfFuelMessage>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>35</costStuffCount>
    <costList>
      <NephilaGooTurretItem>1</NephilaGooTurretItem>
    </costList>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <specialDisplayRadius>32.9</specialDisplayRadius>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>Gun_NephilaTurret</turretGunDef>
      <turretBurstCooldownTime>4.8</turretBurstCooldownTime>
      <turretTopDrawSize>2</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
    </placeWorkers>
    <uiIconScale>0.75</uiIconScale>
     <researchPrerequisites>
      <li>NephilaUnlocker</li>	  
    </researchPrerequisites>		
  </ThingDef>

 
  
