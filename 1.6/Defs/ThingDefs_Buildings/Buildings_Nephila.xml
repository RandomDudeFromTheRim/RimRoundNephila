<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>NephilaScenarioCocoonedOne</defName>
    <label>cocooned one</label>
    <description>The bulging womb of this poor humanoid is a furnace of activity as the nanites within steadily incubate a fully grown nephila maiden.</description>
    <graphicData>
      <texPath>Things/Buildings/Furniture/CocoonedOne</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>	
    <costList>
	  <CocoonedOne>1</CocoonedOne>
	  <CoalescingCherubim>1</CoalescingCherubim>
    </costList>
    <statBases>
      <Mass>100</Mass>	
      <WorkToBuild>25000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Cleanliness>-2</Cleanliness>
	  <Flammability>1.5</Flammability> 
	  <Beauty>10</Beauty>
    </statBases>
 
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <useHitPoints>true</useHitPoints>

    <size>(2,2)</size>
    <designationCategory>Misc</designationCategory>
    <tickerType>Normal</tickerType>	
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(85,85,85,85)</glowColor>
      </li>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>CoalescingNephila</thingToSpawn>
        <spawnCount>1</spawnCount>
        <spawnIntervalRange>
          <min>1500000</min>
          <max>1500000</max>
        </spawnIntervalRange>
        <spawnMaxAdjacent>40</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <saveKeysPrefix>CoalescingNephila</saveKeysPrefix>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>1500050</lifespanTicks>
      </li>	 
    </comps>
     <researchPrerequisites>
      <li>NephilaUnlocker</li>
    </researchPrerequisites>	
  </ThingDef>

