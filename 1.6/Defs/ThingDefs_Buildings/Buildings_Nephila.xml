  <ThingDef ParentName="ArtableBedBase">
    <defName>NephilaGrandMatronBed</defName>
    <label>nephila resting pool</label>
    <description>Deep in their fragrant grottoes, the Nephilim maintain pools of mechanites. All who enter will experience an exquisite tranquility, greatly aiding rest, and the nephila themselves will often melt into them, losing form and embracing the oceanic experience until they are ready to face another day.</description>
    <graphicData>
      <texPath>Things/Buildings/Furniture/Bed/NephilaQueen</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
	<uiIconPath>Things/Buildings/Furniture/Bed/NephilaQueen_Icon</uiIconPath>	
    <castEdgeShadows>True</castEdgeShadows>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Mass>45</Mass>
      <Flammability>1.0</Flammability>
      <BedRestEffectiveness>1</BedRestEffectiveness>
      <Comfort>0.80</Comfort>
      <ImmunityGainSpeedFactor>1.11</ImmunityGainSpeedFactor>
      <MedicalTendQualityOffset>0.10</MedicalTendQualityOffset>
			<SurgerySuccessChanceFactor>1.1</SurgerySuccessChanceFactor>
	</statBases>
    <size>(2,2)</size>		
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VitalsMonitor</li>
          <li>EndTable</li>
          <li>Dresser</li>
        </linkableFacilities>
      </li>  
    </comps>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <costList>
      <Steel>80</Steel>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <building>
      <bed_healPerDay>10</bed_healPerDay>
      <bed_defaultMedical>true</bed_defaultMedical>  
    </building>
    <fillPercent>0.4</fillPercent>
    <pathCost>60</pathCost>
    <leaveResourcesWhenKilled>True</leaveResourcesWhenKilled>
    <staticSunShadowHeight>0.17</staticSunShadowHeight>
    <designationHotKey>Misc5</designationHotKey>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <techLevel>Industrial</techLevel>
     <researchPrerequisites>
      <li>NephilaUnlocker</li>
      <li>HospitalBed</li>	  
    </researchPrerequisites>		
  </ThingDef>

  <ThingDef ParentName="LampBase">
    <defName>Nephila_FountainLamp</defName>
    <label>Nephilim Fountain Lamp</label>
    <description>A stone fountain carved with the likenesses of well-known nephila maidens. The faint glow from the basin is quite pleasing to the eyes. The "stone" fountain is actually composed of trillions of semi-sentient nephila mechanites while the fountain's "water" is actually a liquified form of the original minerals used to create it. Fueled by humanoid milk, this object converts it to nephilitic scinillating milk, which can be gathered any time it is refilled.</description>
    <!--<designatorDropdown>StandingLampColored</designatorDropdown>-->
    <graphicData>
      <texPath>Things/Buildings/Furniture/Nephila_FountainLamp</texPath>
	  <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <tickerType>Normal</tickerType>	
    <costStuffCount>45</costStuffCount>
    <statBases>
      <Mass>6</Mass>
      <WorkToBuild>7000</WorkToBuild>	  
      <Beauty>15</Beauty>	  
    </statBases>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <fillPercent>0.4</fillPercent>
    <pathCost>60</pathCost>
    <!--<staticSunShadowHeight>0.17</staticSunShadowHeight>-->
    <castEdgeShadows>True</castEdgeShadows>	
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>14</glowRadius>
        <glowColor>(217,80,217,0)</glowColor>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.7</fuelConsumptionRate>
        <fuelCapacity>15.0</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0</fuelConsumptionPerTickInRain>
        <fuelFilter>
          <thingDefs>
            <li MayRequire="euterpe.milkytitfuck">SEX_BreastMilk</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="Nephila.CompProperties_CreatesWaste">
        <wasteProduct>IridiscentMilk</wasteProduct>
        <wasteAmount>10</wasteAmount>
      </li>	  
    </comps>
    <size>(2,2)</size>	
    <techLevel>Medieval</techLevel>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
      <li>NephilaUnlocker</li>	  	  
    </researchPrerequisites>
  </ThingDef>

