<Defs>

  <ThingDef ParentName="DrugPillBase">
    <defName>NephilaAngelsNectar</defName>
    <label>Angel's Nectar</label>
    <description>Drawn straight from the tits of a Nephilim Seraphim or Queen's Guard, "angel's nectar" is a cheap luciferium equivalent that gives the same general benefits with greater ease of acquisition. Unfortunately, it's a drug for the desperate: any who take it are doomed to die as the mechanites prepare their bodies for a transformation they were never meant to undergo. For Nephilim Matrons, however, this drug can be a path to ascension, a means of achieving Grand Matronhood.</description>
    <graphicData>
      <texPath>Things/Item/NephilaAngelsNectar</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>35</MarketValue>
      <Mass>0.01</Mass>
    </statBases>
    <techLevel>Ultra</techLevel>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>NephilaPathToAscension</hediffDef>
          <severity>6.5</severity>
          <doToGeneratedPawnIfAddicted>false</doToGeneratedPawnIfAddicted>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>NephilaAngelsNectar</chemical>
        <addictiveness>1.00</addictiveness>
        <needLevelOffset>1.00</needLevelOffset>
        <listOrder>1010</listOrder>
      </li>
    </comps>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>

