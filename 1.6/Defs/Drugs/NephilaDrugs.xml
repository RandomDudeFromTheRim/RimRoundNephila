					<need>SEX_Intimacy</need>
					<offset>-0.25</offset>
				</li>		
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <researchPrerequisite>NephilaUnlocker</researchPrerequisite> 
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
    </recipeMaker>
