<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>NephilaCherubim</defName>
    <label>nephila cherubim</label>
    <description>The animalistic "children" of a nephilim maiden or handmaiden, cherubim are eel-like monstrosities composed of semi-sentient mechanites. They can often be found coiling lazily through the alien "belly gardens" that nephila cultivate in order to propigate their species, and are a core part of the process involved in the creation of the many "Blessed Ones" whose swollen, neon-pulsing wombs dominate those gardens' confines.</description>
    <statBases>
      <Wildness>0.01</Wildness>
      <MoveSpeed>3.5</MoveSpeed>
      <MarketValue>150</MarketValue>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <label>nano-infested fangs</label>
        <capacities>
          <li>NephilaVenomBite</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>  
    </comps>
		<modExtensions>
			<li Class="Nephila.NephilaPawnTerrainHandler">
				<tags>
					<li>Nephila</li>
				</tags>
			</li>
		</modExtensions>		
    <race>
      <body>Snake</body>
      <predator>true</predator>
      <maxPreyBodySize>2.3</maxPreyBodySize>
      <baseBodySize>0.85</baseBodySize>
      <baseHungerRate>0.18</baseHungerRate>
      <baseHealthScale>1.1</baseHealthScale>
      <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
      <leatherDef>Leather_CherubimOoze</leatherDef>
      <meatLabel>cherubimooze</meatLabel>
      <trainability>Advanced</trainability>
      <petness>1</petness>
      <nuzzleMtbHours>24</nuzzleMtbHours>	  
      <manhunterOnTameFailChance>0.01</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.01</manhunterOnDamageChance>
      <nameOnTameChance>1</nameOnTameChance>
      <lifeExpectancy>20</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_Cobra_Wounded</soundWounded>
          <soundDeath>Pawn_Cobra_Death</soundDeath>
          <soundCall>Pawn_Cobra_Call</soundCall>
          <soundAngry>Pawn_Cobra_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>NephilaCherubim</defName>
    <label>nephila cherubim</label>
    <race>NephilaCherubim</race>
    <combatPower>75</combatPower>
    <ecoSystemWeight>0.25</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/NephilaCherubim</texPath>
          <drawSize>1</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cobra/Dessicated_Cobra</texPath>
          <drawSize>1</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/NephilaCherubim</texPath>
          <drawSize>1.25</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cobra/Dessicated_Cobra</texPath>
          <drawSize>1.25</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/NephilaCherubim</texPath>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cobra/Dessicated_Cobra</texPath>
          <drawSize>1.5</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
  
