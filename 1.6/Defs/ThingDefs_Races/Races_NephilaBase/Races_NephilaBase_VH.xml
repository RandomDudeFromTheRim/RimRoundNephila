				<milkThoughtMilker>NephilaGather</milkThoughtMilker>
				<milkThoughtMilked>NephilaGatheredFrom</milkThoughtMilked>
				<milkThoughtMilkedSelf>NephilaGatheredFromSelfMood</milkThoughtMilkedSelf>
				<firstResourceName>False</firstResourceName>
				<forbiddenJobsToInterrupt>
					<li>GotoSafeTemperature</li>
					<li>Wait_Combat</li>
					<li>AttackStatic</li>
					<li>AttackMelee</li>
					<li>SocialFight</li>
					<li>UseNeurotrainer</li>
					<li>UseArtifact</li>
					<li>Flee</li>
					<li>FleeAndCower</li>
					<li>Resurrect</li>
					<li>BeatFire</li>
					<li>ExtinguishSelf</li>
					<li>Lovin</li>
					<li>Rescue</li>
					<li>Capture</li>
					<li>TakeToBedToOperate</li>
					<li>TakeWoundedPrisonerToBed</li>
					<li>EscortPrisonerToBed</li>
					<li>FeedPatient</li>
					<li>TendPatient</li>
				</forbiddenJobsToInterrupt>
			</li>
