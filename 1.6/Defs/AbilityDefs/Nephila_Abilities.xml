<Defs>

  <AbilityDef ParentName="PsycastBase">
    <defName>LactationInduction</defName>
    <label>induce lactation</label>
    <description>Psionic power originally developed by the Nephilim. Alter a pawn's biology so that their breasts slowly swell and lactate.</description>
    <level>1</level>
    <iconPath>UI/Abilities/Painblock</iconPath>
    <hotKey>Misc1</hotKey>
    <statBases>
      <Ability_EntropyGain>8</Ability_EntropyGain>
      <Ability_PsyfocusCost>0.02</Ability_PsyfocusCost>
      <Ability_Duration>1200000000</Ability_Duration>
    </statBases>
    <verbProperties>
      <warmupTime>0.25</warmupTime>
      <range>24.9</range>
      <targetParams>
        <canTargetSelf>True</canTargetSelf>
        <canTargetAnimals>False</canTargetAnimals>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class = "CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>NephilaInducedLactation</hediffDef>
        <!--<durationMultiplier>PsychicSensitivity</durationMultiplier>-->
        <psychic>True</psychic>
        <applicableToMechs>False</applicableToMechs>
      </li>
    </comps>
  </AbilityDef>

