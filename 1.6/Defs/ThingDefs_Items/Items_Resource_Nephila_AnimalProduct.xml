<Defs>

  <!--=====================================================================-->
  <!--=============================== Nephila Worm Milk ===================-->
  <!--=====================================================================-->

  <ThingDef ParentName="OrganicProductBase">
    <defName>IridiscentMilk</defName>
    <label>iridiscent milk</label>
    <description>Glowing multicolored milk gathered from a milk producing Nephila's heaving breasts. High in both nutrition value and taste. Can be reduced in a pool of nephila nanites to produce Angel's Nectar, a royal jelly equivalent that is vital to the process of triggering the ascension of a Nephila Grand Matron.</description>
    <graphicData>
      <texPath>Things/Item/NephilaLactase</texPath>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MarketValue>6.0</MarketValue>
      <Mass>0.045</Mass>
	  <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Nutrition>0.15</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>24</daysToRotStart>
				<rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawTasty</preferability>
      <foodType>AnimalProduct, Fluid</foodType>
    </ingestible>
    <thingCategories>
      <li>AnimalProductRaw</li>
    </thingCategories>
  </ThingDef>



