<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>Plant_NephilaSerpentsGrass</defName>
    <label>nephilim serpent's grass</label>
    <description>This "plant" is redolent with nephilim mechanites, its serpentine "flower" seeming to track the motions of nearby fauna. It seems to pay special attention to males.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Beauty>13</Beauty>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Nephila_SerpentsGrass</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <ingestible />
    <plant>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <sowWork>750</sowWork> <!-- 100 ticks per live day -->
      <sowTags>
        <li>Ground</li>
        <li>Decorative</li>
      </sowTags>
      <growMinGlow>0.3</growMinGlow>
      <topWindExposure>0.1</topWindExposure>
      <growDays>1.5</growDays>
      <lifespanDaysPerGrowDays>5</lifespanDaysPerGrowDays>
      <visualSizeRange>0.3~1.05</visualSizeRange>
      <wildOrder>1</wildOrder>
      <purpose>Beauty</purpose>
	  
      <harvestWork>350</harvestWork>
      <harvestYield>5</harvestYield>
	  <harvestedThingDef>Nephila_NephilaCollectedOoze</harvestedThingDef>	  
	  
    </plant>
  </ThingDef>

   <ThingDef ParentName="DeciduousTreeBase">
    <defName>Plant_NephilimLadyTree</defName>
    <label>thirsting bitrch tree</label>
    <description>Formerly a poplar tree, this organism evokes the female form that nephilim mechanites are programmed to express. Not truly sentient, it can still be seen gesturing, on occasion, to passerby, acting out the whorish agenda of the beings it plays host to.</description>
    <graphicData>
      <texPath>Things/Plant/Nephila_LadyTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.15, 0.3, 0.1)</volume>
        <offset>(-0.03,0,-0.44)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
      <Nutrition>1.25</Nutrition>
    </statBases>
    <ingestible />
    <plant>
      <growDays>20</growDays>
      <harvestWork>800</harvestWork>
      <harvestYield>27</harvestYield>
	  <harvestedThingDef>Nephila_NephilaCollectedOoze</harvestedThingDef>	  
    </plant>
  </ThingDef>


  <ThingDef ParentName="PlantBase">
    <defName>Plant_NephilaGrass</defName>
    <label>mechanite dusted grass</label>
    <description>Wild grass. Grows anywhere there is a little light and minimally fertile ground. This particular variety has been dusted by a thin layer of nephila mechanites.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Flammability>1.3</Flammability>
      <Nutrition>0.25</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Nephila_Grass</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <ingestible />
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>2.5</growDays>
      <leaflessGraphicPath>Things/Plant/Nephila_Grass</leaflessGraphicPath>
      <harvestWork>40</harvestWork>
      <maxMeshCount>9</maxMeshCount>
      <visualSizeRange>0.4~0.6</visualSizeRange>
      <topWindExposure>0.4</topWindExposure>
      <wildOrder>1</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>Plant_NephiliticTallGrass</defName>
    <label>tall grass</label>
    <description>Wild tall grass. Slows down anyone moving over it. This particular variety has been dusted by a thin layer of nephila mechanites.</description>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <Flammability>1.3</Flammability>
      <Nutrition>0.30</Nutrition>
    </statBases>
    <pathCost>15</pathCost>
    <graphicData>
      <texPath>Things/Plant/Nephila_Grass</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <ingestible />
    <plant>
      <fertilitySensitivity>0.7</fertilitySensitivity>
      <growDays>3</growDays>
      <harvestWork>60</harvestWork>
      <maxMeshCount>9</maxMeshCount>
      <visualSizeRange>0.7~0.85</visualSizeRange>
      <topWindExposure>0.4</topWindExposure>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>10</wildClusterWeight>
      <wildOrder>1</wildOrder>
    </plant>
  </ThingDef>


 <ThingDef ParentName="DeciduousTreeBase">
    <defName>Plant_NephilaPaperbark</defName>
    <label>mechanite dusted paperbark</label>
    <description>A temperate-biome tree known for its thin, white, paper-like bark. It is covered in a dusting of nephila mechanites and seems to have gone slightly wrong, but its wood should still be useful.</description>
    <graphicData>
      <texPath>Things/Plant/Nephila_Paperbark</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.15, 0.3, 0.1)</volume>
        <offset>(-0.03,0,-0.44)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
      <Nutrition>1.25</Nutrition>
    </statBases>
    <ingestible />
    <plant>
      <growDays>20</growDays>
      <harvestWork>800</harvestWork>
      <harvestYield>27</harvestYield>
      <leaflessGraphicPath>Things/Plant/Nephila_Paperbark</leaflessGraphicPath>
    </plant>
  </ThingDef>

  <ThingDef ParentName="BushBase">
    <defName>Plant_NephilaUrchinPlant</defName>
    <label>nephilim urchin plant</label>
    <description>A short, shrublike plant that resembles a sea urchin. Liquid Nephila mechanite accretions can be seen swirling between its inner stalks and a light glow indicates a radius of protective mechanites that surround the plant, increasing feelings of lust in those who draw too close.</description>
    <graphicData>
      <texPath>Things/Plant/NephilaUrchinPlant</texPath>
      <drawSize>1.15</drawSize>
      <shadowData>
        <volume>(0.55, 0.2, 0.2)</volume>
      </shadowData>
    </graphicData>
    <tickerType>Normal</tickerType>		
    <uiIconScale>0.85</uiIconScale>
    <plant>
      <growDays>3</growDays>
      <leaflessGraphicPath>Things/Plant/NephilaUrchinPlant</leaflessGraphicPath>	  
      <harvestYield>5</harvestYield>
      <harvestWork>250</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestAfterGrowth>0.30</harvestAfterGrowth>
      <harvestedThingDef>SucculentUrchinTendrils</harvestedThingDef>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>250</wildClusterWeight>
      <visualSizeRange>0.95~1.7</visualSizeRange>
      <topWindExposure>0.3</topWindExposure>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>	  	  
    </plant>
