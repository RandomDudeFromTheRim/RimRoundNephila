  <ThingDef ParentName="ArmorMachineableBase">
    <defName>Apparel_NephilaPalanquin</defName>
    <label>Nephila Matron's Oozing Palanquin</label>
    <description>This basic palanquin provides overburdened Nephila Matrons with reasonable mobility (given their condition) at minor cost.</description>
    <techLevel>Neolithic</techLevel>
