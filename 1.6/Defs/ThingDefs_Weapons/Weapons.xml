     <ThingDef ParentName="BaseBullet">
		<defName>Bullet_NephRifle</defName>
		<label>charge shot</label>
		<graphicData>
			<texPath>Spells/nephGMShotOther</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
