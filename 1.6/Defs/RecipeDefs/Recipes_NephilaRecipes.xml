<Defs>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>InstallNephilaMechaniteInhibitor</defName>
    <label>install nephila mechanite inhibitor</label>
    <description>Install a nephila mechanite inhibitor.</description>
    <workerClass>Recipe_InstallImplant</workerClass>
    <jobString>Installing nephila mechanite inhibitor.</jobString>
    <workAmount>3700</workAmount>
    <deathOnFailedSurgeryChance>0.10</deathOnFailedSurgeryChance>
    <skillRequirements>
      <Medicine>8</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>NephilaMechaniteInhibitor</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
      <thingDefs>
        <li>NephilaMechaniteInhibitor</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Brain</li>
    </appliedOnFixedBodyParts>
    <addsHediff>NephilaMechaniteInhibitor</addsHediff>
  </RecipeDef>

