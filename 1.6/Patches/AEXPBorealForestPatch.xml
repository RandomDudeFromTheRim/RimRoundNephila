<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Animals Expanded — Boreal Forest</li>
		</mods>

		<match Class="PatchOperationSequence">
			<operations>


			
			<li Class="PatchOperationAdd"> 
				<xpath>/Defs/ThingDef[defName="AEXP_Otter"]/race/wildBiomes</xpath>
				<value>

					<Nephila_NephiliticEden>0.2</Nephila_NephiliticEden>
					
				</value>
			</li>
			

			
			<li Class="PatchOperationAdd"> 
				<xpath>/Defs/ThingDef[defName="AEXP_BlackBear"]/race/wildBiomes</xpath>
				<value>
					
					<Nephila_NephiliticEden>0.01</Nephila_NephiliticEden>
					
					
				</value>
			</li>
			
			
			
			
			
			
		</operations>
		</match>
	</Operation>
	
	
</Patch>