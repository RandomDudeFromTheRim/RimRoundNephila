<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationFindMod">
		<mods>
			<li>FemaleBB BodyType Support</li>
		</mods>
		  <match Class="PatchOperationSequence">
			<success>Always</success>
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="NephilaHumanEquiv"]/alienRace/generalSettings/alienPartGenerator/alienbodytypes</xpath>
					<value>
							<li>FemaleBB</li>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/AlienRace.BackstoryDef[defName="Nephila_SlaveChild"]/bodyTypeFemale/Female</xpath>
					<value>
							<li>FemaleBB</li>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/AlienRace.BackstoryDef[defName="Nephila_EscapedSlave"]/bodyTypeFemale/Female</xpath>
					<value>
							<li>FemaleBB</li>
					</value>
				</li>				
			</operations>
		  </match>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<!-- Human Surgery -->
		<xpath>/Defs/ThingDef[defName="Human"]/recipes</xpath>
		<value>
			<li>InstallNephilaMechaniteInhibitor</li>
		</value>
	</Operation>	
	
	<Operation Class="PatchOperationAdd">
		<!-- Human Surgery -->
		<xpath>/Defs/ThingDef[defName="Human"]/recipes</xpath>
		<value>
			<li>RemoveNephilaMechaniteInhibitor</li>
		</value>
	</Operation>	

	<Operation Class="PatchOperationAdd">
		<!-- <success>Always</success> -->
		<xpath>/Defs/StorytellerDef[@Name = "BaseStoryteller"]/comps</xpath>
		<value>
			<li Class="StorytellerCompProperties_SingleOnceFixed">
				<fireAfterDaysPassed>4</fireAfterDaysPassed>
				<incident MayRequire="Ludeon.RimWorld.Royalty">Nephila_GiveQuest_Intro_Wimp</incident>
				<allowedTargetTags>
					<li>World</li>
				</allowedTargetTags>
				<enableIfAnyModActive>
					<li>Ludeon.RimWorld.Royalty</li>
				</enableIfAnyModActive>
			</li>			
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<success>Always</success>
		<xpath>/Defs/StorytellerDef[@Name = "BaseStoryteller"]/comps</xpath>
		<value>
			<li Class="StorytellerCompProperties_RefiringUniqueQuest">
				<minDaysPassed>21</minDaysPassed>
					<refireEveryDays>22</refireEveryDays>
				<incident MayRequire="Ludeon.RimWorld.Royalty">Nephila_GiveQuest_EndGame_CorpAscent</incident>
				<allowedTargetTags>
					<li>World</li>
				</allowedTargetTags>
				<enableIfAnyModActive>
					<li>Ludeon.RimWorld.Royalty</li>
				</enableIfAnyModActive>
			</li>			
		</value>
	</Operation>


		
	
</Patch>