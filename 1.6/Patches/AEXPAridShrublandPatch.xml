						<Nephila_NephiliticEden>0.07</Nephila_NephiliticEden>
					</value>
				</li>


				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/ThingDef[defName="AEXP_Crocodile"]/race/wildBiomes</xpath>
